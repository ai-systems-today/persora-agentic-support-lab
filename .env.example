# Fixture mode needs no credentials.
APP_MODE=fixture

# Live published-agent mode uses a public widget identifier and does not need a browser secret.
# The widget's allowed-origin configuration still controls whether a deployment may call it.

# Optional server-side integrations. Never expose these through VITE_* variables.
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
PINECONE_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
